# ============================================================
# PixGPT — server configuration
# ------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored and is read
# ONLY by the PixGPT server process (server/). Nothing here is
# bundled into the browser build, so gateway credentials never
# reach the client.
#
# See docs/ai-gateways.md for the full guide.
# ============================================================

# --- PixGPT server ---
# Port the PixGPT API/static server listens on.
# NOTE: Portkey Gateway also defaults to 8787 — change one of them
# if you run Portkey locally.
PORT=8787

# ============================================================
# AI GATEWAY SELECTION
# ============================================================
# Which gateway backend to talk to. Default: omniroute.
# Supported: omniroute | openrouter | freebuff | litellm | bifrost | oneapi | newapi | higress | portkey
AI_GATEWAY_PROVIDER=omniroute

# Generic gateway settings. Each is optional — every gateway has a
# documented default (see docs/ai-gateways.md).
#
# Precedence for every setting, highest first:
#   1. <PROVIDER>_<SETTING>   e.g. OMNIROUTE_BASE_URL, LITELLM_BASE_URL
#   2. AI_GATEWAY_<SETTING>   the generic knob below
#   3. the adapter's built-in default
#
# That ordering is what keeps a pre-existing OmniRoute-only .env
# working untouched: OMNIROUTE_* names are just case 1.

# AI_GATEWAY_URL=
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_DEFAULT_MODEL=
# AI_GATEWAY_HEALTH_PATH=
# AI_GATEWAY_FALLBACK_MODELS=

# Three independent timeouts (see docs/production.md §3):
#   CONNECT — time allowed to get response headers back
#   TIMEOUT — idle timeout, resets on every streamed chunk
#   MAX_STREAM — absolute ceiling for one response
# AI_GATEWAY_CONNECT_TIMEOUT_MS=15000
# AI_GATEWAY_TIMEOUT_MS=60000
# AI_GATEWAY_MAX_STREAM_MS=300000

# ============================================================
# IMAGE / MULTIMODAL INPUT
# ============================================================
# Which PixGPT aliases may carry images. A gateway declaring
# vision support does NOT make every model multimodal, and only you
# know what PIXGPT_MODEL_PRO actually points at — so this is
# explicit configuration rather than a guess.
# Default: pixgpt-vision only.
# PIXGPT_VISION_ALIASES=pixgpt-vision,pixgpt-pro
# Per-gateway override, e.g. LITELLM_VISION_ALIASES=pixgpt-vision

# Formats forwarded to the model. Keep this to what your model reads.
# ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Size limits. Base64 inflates bytes by ~1.37x, so MAX_REQUEST_SIZE_MB
# must comfortably exceed MAX_IMAGE_SIZE_MB x MAX_IMAGES_PER_MESSAGE.
# MAX_IMAGE_SIZE_MB=4
# MAX_IMAGES_PER_MESSAGE=3
# MAX_REQUEST_SIZE_MB=10

# Remote image URLs are DISABLED by default: accepting arbitrary URLs
# would give the gateway a request-forgery primitive against anything
# on its network. Enable only with an explicit host allowlist.
# ALLOW_REMOTE_IMAGE_URLS=false
# REMOTE_IMAGE_HOSTS=cdn.example.com

# ============================================================
# DOCUMENT UNDERSTANDING
# ============================================================
# Uploaded documents are never sent to the model as binary. The
# server extracts plain text and injects it as a fenced text block,
# so documents work on every model — no vision capability needed.
#
# Supported now: txt, log, md, csv, tsv, json, jsonl, docx and
# common source-code files.
# PDF is NOT enabled: both maintained pure-JS extractors require
# Node >= 20/22 and this server runs Node 18. See docs/capabilities.md.

# MAX_FILE_SIZE_MB=5
# MAX_DOCUMENT_TEXT=120000          # characters kept per file, then truncated
# MAX_FILES_PER_MESSAGE=3
# DOCUMENT_EXTRACT_TIMEOUT_MS=10000 # wall-clock ceiling for parsing one file
# MAX_DOCUMENT_EXPANSION_RATIO=200  # archive-bomb guard for docx

# --- Rate limiting for /api/chat ---
# In-memory and per process. Set RATE_LIMIT_MAX=0 to disable (handy locally).
# Multi-instance deployments should limit at the reverse proxy instead —
# see docs/production.md §4.
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000

# ============================================================
# OMNIROUTE (default gateway)
# ============================================================
# Base URL of the OmniRoute OpenAI-compatible API.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# API key from the OmniRoute dashboard (Dashboard -> Endpoints).
# Leave empty if your instance runs with REQUIRE_API_KEY=false.
OMNIROUTE_API_KEY=

# Milliseconds to wait for activity from the gateway before giving up.
# The clock resets on every streamed chunk, so long answers are safe.
OMNIROUTE_TIMEOUT_MS=60000

# Health probe path on the gateway host (not under /v1).
OMNIROUTE_HEALTH_PATH=/api/health/ping

# Comma-separated fallback chain, tried in order when the requested
# model fails before any tokens have streamed. Leave empty to rely
# solely on the gateway's own native routing.
OMNIROUTE_FALLBACK_MODELS=auto

# ============================================================
# MODEL ALIASES
# ============================================================
# PixGPT's UI offers three branded models. Each maps to a real model
# id understood by the selected gateway. Any model id not listed here
# is passed through unchanged, so the UI can also request a concrete
# provider model.
#
# `PIXGPT_MODEL_*` applies to every gateway. Because model names are
# rarely portable (`auto` means something to OmniRoute and nothing to
# LiteLLM), you can override per gateway with e.g. LITELLM_MODEL_PRO.
PIXGPT_MODEL_FAST=auto
PIXGPT_MODEL_PRO=auto
PIXGPT_MODEL_VISION=auto

# ============================================================
# ALTERNATIVE GATEWAYS (only the selected one is used)
# ============================================================
# Uncomment the block for the gateway you set above. Each gateway runs
# as its own service — see docs/ai-gateways.md for run commands.

# --- LiteLLM — http://localhost:4000/v1 ---
# LITELLM_BASE_URL=http://localhost:4000/v1
# LITELLM_API_KEY=sk-...
# LITELLM_MODEL_FAST=gpt-4o-mini
# LITELLM_MODEL_PRO=gpt-4o
# LITELLM_MODEL_VISION=gpt-4o

# --- Bifrost — http://localhost:8080/v1 ---
# BIFROST_BASE_URL=http://localhost:8080/v1
# BIFROST_API_KEY=
# BIFROST_MODEL_PRO=openai/gpt-4o-mini

# --- One API — http://localhost:3000/v1 ---
# ONEAPI_BASE_URL=http://localhost:3000/v1
# ONEAPI_API_KEY=
# ONEAPI_MODEL_PRO=gpt-4o-mini

# --- New API — http://localhost:3000/v1 (AGPL-3.0) ---
# NEWAPI_BASE_URL=http://localhost:3000/v1
# NEWAPI_API_KEY=
# NEWAPI_MODEL_PRO=gpt-4o-mini

# --- Higress — http://localhost:8080/v1 (needs ai-proxy plugin configured) ---
# HIGRESS_BASE_URL=http://localhost:8080/v1
# HIGRESS_API_KEY=
# HIGRESS_MODEL_PRO=qwen-turbo

# --- Portkey Gateway — http://localhost:8787/v1 (port clashes with PixGPT!) ---
# PORTKEY_BASE_URL=http://localhost:8787/v1
# PORTKEY_API_KEY is the UPSTREAM PROVIDER key, sent as Authorization: Bearer
# PORTKEY_API_KEY=

# ============================================================
# OPENROUTER
# ============================================================
# 400+ models behind one OpenAI-compatible surface, with a public
# catalogue that carries real context windows and capability flags.
#
# Setting a key does two things: it enables the gateway, and it lets
# those models join the same ranking as every other gateway's — one
# registry, one fallback chain, no gateway picker in the UI.
#
# Get a key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Optional attribution, used by OpenRouter's public leaderboard.
# Neither carries a credential.
# OPENROUTER_SITE_URL=https://pixgpt.local
# OPENROUTER_APP_NAME=PixGPT

# ============================================================
# FREEBUFF
# ============================================================
# A proxy in front of OpenRouter. Its model ids ARE OpenRouter ids, so
# if you hold an OpenRouter key the `openrouter` gateway above reaches
# the same models one hop shorter. Use this only when your credentials
# are for Freebuff itself.
# FREEBUFF_API_KEY=

# Freebuff's bring-your-own-key passthrough: your own OpenRouter key,
# forwarded upstream so it bills you rather than them.
# FREEBUFF_BYOK_OPENROUTER=

# ============================================================
# MODEL REGISTRY
# ============================================================
# How long a catalogue read is reused before re-fetching.
# PIXGPT_MODEL_CATALOGUE_TTL_MS=300000
# How long a verification is remembered across restarts.
# PIXGPT_MODEL_MEMORY_TTL_MS=86400000
# Probing spends real quota, so it is capped and gated.
# PIXGPT_PROBE_MAX_TOKENS=16
# PIXGPT_PROBE_MAX_MODELS=24
# PIXGPT_PROBE_CONCURRENCY=3
# Models per fallback chain.
# PIXGPT_CHAIN_LENGTH=4
# Budget for a route already known to be broken, before the chain moves on.
# PIXGPT_KNOWN_BAD_TIMEOUT_MS=4000
# Required to call POST /api/models/probe from anywhere but this machine.
# PIXGPT_ADMIN_TOKEN=

# ============================================================
# CODING AGENT
# ============================================================
# Context the symbol map may occupy in the agent's system prompt.
# AGENT_CODEMAP_TOKENS=2500
# AGENT_CODEMAP_MAX_FILES=600
# Transcript budget for one agent turn.
# AGENT_CONTEXT_TOKENS=60000
# Which provider Portkey should route to (required unless using a virtual key/config)
# PORTKEY_PROVIDER=openai
# Optional Portkey platform key, sent as the x-portkey-api-key header
# PORTKEY_PLATFORM_KEY=
# PORTKEY_VIRTUAL_KEY=
# Portkey's own routing/fallback config, sent as x-portkey-config
# PORTKEY_CONFIG={"strategy":{"mode":"fallback"}}
# PORTKEY_MODEL_PRO=gpt-4o-mini

# --- Logging ---
# error | warn | info | debug
LOG_LEVEL=info

# ============================================================
# WEB SEARCH GROUNDING
# ============================================================
# Why: a model's training has a cutoff, so it answers current-events
# questions from stale memory. Enabling search lets the SERVER retrieve
# live pages and put them in front of the model. The model never gets
# network access and never chooses a URL.
#
# Providers:
#   duckduckgo  keyless, works out of the box (default)
#   wikipedia   keyless, encyclopedic questions
#   brave       needs WEB_SEARCH_API_KEY
#   tavily      needs WEB_SEARCH_API_KEY (built for LLM grounding)
#   searxng     needs WEB_SEARCH_URL (self-hosted)
#   none        disabled
WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_URL=

# Bounds — retrieval is never unlimited.
# WEB_SEARCH_MAX_RESULTS=5        # results requested from the provider
# WEB_SEARCH_MAX_PAGES=3          # of those, how many to open and read
# WEB_SEARCH_MAX_PAGE_BYTES=400000
# WEB_SEARCH_MAX_PAGE_CHARS=6000  # text kept per page
# WEB_SEARCH_MAX_CONTEXT_CHARS=24000
# WEB_SEARCH_TIMEOUT_MS=15000

# ============================================================
# CODING AGENT (Build mode)
# ============================================================
# Each task gets an isolated workspace; the agent cannot read or write
# outside it, and spawned commands inherit none of the secrets above.
# WORKSPACE_ROOT=.pixgpt-workspaces
# AGENT_MAX_ITERATIONS=40           # tool-call rounds per task
# AGENT_MAX_WALL_MS=900000          # wall-clock budget per task
# AGENT_MODEL_TIMEOUT_MS=180000     # one model turn may generate a whole file
# AGENT_COMMAND_TIMEOUT_MS=300000   # per command
# AGENT_MAX_OUTPUT_CHARS=24000      # captured stdout/stderr per command
# AGENT_MAX_WORKSPACE_BYTES=314572800
# AGENT_MAX_FILE_BYTES=2000000
# AGENT_MAX_ZIP_BYTES=62914560
# AGENT_APPROVAL_TIMEOUT_MS=120000  # how long a command waits for approval

# --- Build mode: preview server ------------------------------------------
# The generated project is started on a loopback-only port from a private range.
# AGENT_PREVIEW_PORT_MIN=41000
# AGENT_PREVIEW_PORT_MAX=41400
# AGENT_PREVIEW_READY_MS=90000     # how long to wait for it to answer HTTP

# --- Build mode: browser testing -----------------------------------------
# A real Chrome or Edge, headless, with a throwaway profile per task. Found
# automatically on the usual install paths; set this only if it lives elsewhere.
# PIXGPT_BROWSER_PATH=
# AGENT_BROWSER_TIMEOUT_MS=30000
# AGENT_VISION_TIMEOUT_MS=120000   # screenshot analysis is a vision model call
# AGENT_SMOKE_STEP_MS=300000       # per step of the delivery check

# --- Document generation --------------------------------------------------
# Generated PDF/DOCX/PPTX files are held in memory and downloaded by id, then
# expire. They are derived artefacts, not user data.
# ARTIFACT_TTL_MS=1800000          # 30 minutes
# ARTIFACT_MAX_COUNT=60
# ARTIFACT_MAX_TOTAL_BYTES=314572800
# DOC_AUTHOR_TIMEOUT_MS=240000     # the model writing a whole document
# DOC_MAX_PDF_BYTES=26214400       # PDF upload limit for reading and editing

# ============================================================
# Web search — multi-provider, free-first
# ============================================================
# Priority defaults to: self-hosted, then free, then metered.
# Set these only to override that order.
# SEARCH_PROVIDER_PRIMARY=searxng
# SEARCH_PROVIDER_FALLBACK_1=brave
# SEARCH_PROVIDER_FALLBACK_2=tavily
# SEARCH_PROVIDER_ORDER=searxng,whoogle,brave

# --- self-hosted (preferred: no credits, no third party) ---
# SearXNG must have JSON enabled in settings.yml:
#   search: { formats: [html, json] }
# SEARXNG_URL=http://127.0.0.1:8080
# WHOOGLE_URL=http://127.0.0.1:5000

# --- free, no key ---
# WIKIPEDIA_ENABLED=true
# DUCKDUCKGO_ENABLED=true
# GITHUB_ENABLED=true
# A token lifts GitHub to 30 req/min and is REQUIRED for code search
# GITHUB_TOKEN=

# --- metered API allowances ---
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# EXA_API_KEY=

# --- limits ---
# SEARCH_TIMEOUT_MS=15000
# SEARCH_BREAKER_THRESHOLD=3       # failures before a provider is skipped
# SEARCH_CACHE_MAX_ENTRIES=300
# SEARCH_CACHE_TTL_LIVE_MS=60000   # "latest"/"today" queries expire fast
# SEARCH_CACHE_TTL_NEWS_MS=300000
# SEARCH_CACHE_TTL_WEB_MS=900000
# SEARCH_CACHE_TTL_REFERENCE_MS=21600000
# SEARCH_MAX_PAGE_BYTES=600000
# SEARCH_MAX_PASSAGE_CHARS=6000
# SEARCH_PAGE_TIMEOUT_MS=12000
# RESEARCH_SYNTHESIS_TIMEOUT_MS=180000

# ============================================================
# Vision routing
# ============================================================
# Fallbacks MUST be vision-capable. A text-only model here answers every
# image request with bad_request and silently defeats visual checking.
# VISION_TIMEOUT_MS=120000
# VISION_PROBE_TIMEOUT_MS=45000

# ============================================================
# Image and video generation
# ============================================================
# Nothing is downloaded automatically. Diffusion needs a CUDA or ROCm
# accelerator; without one, PixGPT reports local generation as unavailable
# and the deterministic renderer handles gradients, patterns, cards and charts.
# IMAGE_GENERATION_PROVIDER=comfyui
# IMAGE_GENERATION_FALLBACK=renderer
# VIDEO_GENERATION_PROVIDER=comfyui
# VIDEO_GENERATION_FALLBACK=

# ComfyUI runs as a separate service; heavy work never enters the chat process
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_TIMEOUT_MS=600000

# A generic remote adapter, so PixGPT is not tied to one vendor
# GENERATION_REMOTE_URL=
# GENERATION_REMOTE_API_KEY=
# GENERATION_REMOTE_AUTH_HEADER=Authorization
# GENERATION_REMOTE_AUTH_PREFIX="Bearer "
# GENERATION_REMOTE_STATUS_PATH=
# GENERATION_REMOTE_VIDEO_URL=
# GENERATION_REMOTE_TIMEOUT_MS=300000

# --- limits ---
# Two large models on one GPU exhaust VRAM rather than sharing it
# GENERATION_WORKER_CONCURRENCY=1
# GENERATION_MAX_QUEUE=24
# MAX_GENERATION_JOBS=200
# GENERATION_JOB_TTL_MS=7200000
# MAX_IMAGE_OUTPUT_MB=25
# MAX_VIDEO_OUTPUT_MB=200
# MAX_BATCH_SIZE=4
